{
    "name": "bisubox/bisubox",
    "description": "Sistema administrativo para bisutería BisuBox",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-fileinfo": "*",
        "phpmailer/phpmailer": "^7.2"
    },
    "autoload": {
        "psr-4": {
            "Aplicacion\\": "Aplicacion/",
            "Configuracion\\": "Configuracion/"
        }
    },
    "config": {
        "optimize-autoloader": true
    }
}
